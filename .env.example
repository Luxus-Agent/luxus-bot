# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://luxus:dhanush@localhost/luxus

# ── Redis (Celery broker) ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Environment ───────────────────────────────────────────────────────────────
# "development" → NOWPayments sandbox
# "production"  → NOWPayments live
APP_ENV=development

# Logging verbosity: DEBUG | INFO | WARNING | ERROR  (use DEBUG to trace issues)
LOG_LEVEL=INFO

# CORS — comma-separated allowed frontend origins, or "*" for any.
# In production set this to your hosted frontend URL(s):
#   CORS_ORIGINS=https://app.yourdomain.com
CORS_ORIGINS=*

# ── NOWPayments ───────────────────────────────────────────────────────────────
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret

# Public URL of this backend (NOWPayments will POST the IPN callback here)
# For local dev you can use ngrok: ngrok http 8000
NOWPAYMENTS_CALLBACK_BASE=https://yourdomain.com

# Frontend URL (used in payment success/cancel redirects + email links).
# When hosted, set this to your live frontend URL, e.g. https://app.yourdomain.com
FRONTEND_URL=http://localhost:3000

# ── Admin Seed ────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@luxus.io
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_REFERRAL_CODE=ADMIN001

# ── SMTP (Email) ───────────────────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=your-gmail@gmail.com

# On-chain pack-purchase payout (BEP-20 USDT) — see app/config.py
PLATFORM_FEE_WALLET=your-wallet-address
USDT_CONTRACT=your-usdt-contract-address
USDT_DECIMALS=6
PAYOUT_CURRENCY=USDT
PAYOUT_NETWORK=BEP-20
