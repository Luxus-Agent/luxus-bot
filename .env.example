# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://luxus:dhanush@localhost/luxus

# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Environment ───────────────────────────────────────────────────────────────
# "development" | "production"
APP_ENV=development

# Logging verbosity: DEBUG | INFO | WARNING | ERROR  (use DEBUG to trace issues)
LOG_LEVEL=INFO

# CORS — comma-separated allowed frontend origins, or "*" for any.
# In production set this to your hosted frontend URL(s):
#   CORS_ORIGINS=https://app.yourdomain.com
CORS_ORIGINS=*

# Frontend URL (used in email links).
# When hosted, set this to your live frontend URL, e.g. https://app.yourdomain.com
FRONTEND_URL=http://localhost:3000

# ── Admin Seed ────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@luxus.io
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_REFERRAL_CODE=ADMIN001

# ── SMTP (Email) ───────────────────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=your-gmail@gmail.com

# On-chain pack-purchase payout (BEP-20 USDT) — see app/config.py
# PLATFORM_FEE_WALLET receives the flat per-tier fee, the 10% Core software fee,
# and the Stream (30%) + Boost-pool (9%) shares (those matrix pools are tracked
# internally, not held in their own on-chain wallet).
PLATFORM_FEE_WALLET=your-wallet-address
USDT_CONTRACT=your-usdt-contract-address
USDT_DECIMALS=6
PAYOUT_CURRENCY=USDT
PAYOUT_NETWORK=BEP-20

# Platform wallet roles. ADMIN_INCOME_WALLET and REPURCHASE_RESERVE_WALLET each
# fall back to PLATFORM_FEE_WALLET when left empty — set distinct addresses
# before go-live.
# ADMIN_INCOME_WALLET       — receives the 1% Boost-allocation admin cut per purchase
# REPURCHASE_RESERVE_WALLET — receives the 20% repurchase reserve skimmed per commission
ADMIN_INCOME_WALLET=your-wallet-address
REPURCHASE_RESERVE_WALLET=your-wallet-address

# Auto-repurchase on-chain settlement — moves the consumed reserve (price + fee)
# from the reserve wallet to PLATFORM_FEE_WALLET automatically, no admin approval.
# REPURCHASE_SIGNER_PRIVATE_KEY must be REPURCHASE_RESERVE_WALLET's own private
# key — that wallet needs both USDT (the reserve) and BNB (gas) funded manually;
# there is no automated top-up. Leave the key empty to keep auto-repurchase
# internal-ledger-only (today's default/safe behavior) — no transaction is ever
# attempted. THIS IS A LIVE PRIVATE KEY once set. Treat it exactly like
# SECRET_KEY: never commit a real one, never share it (this key signs
# unattended, with no human approval step).
# BSC_RPC_URL defaults to BSC TESTNET (matches the mock USDT_CONTRACT this repo
# ships with) — only point this at a mainnet RPC once USDT_CONTRACT is upgraded
# to the real mainnet USDT token.
BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
REPURCHASE_SIGNER_PRIVATE_KEY=
