# Frontend build-time config (Vite). Copy to `.env.production` (or `.env.local`)
# and fill in. ONLY variables prefixed with VITE_ are exposed to the app.

# Backend API base URL.
# - LOCAL DEV: leave this UNSET — the app falls back to '/api' and Vite's dev
#   proxy (vite.config.js) forwards it to http://localhost:8000.
# - PRODUCTION, same domain (reverse proxy routes /api → backend): leave UNSET.
# - PRODUCTION, different domain (frontend and backend on separate hosts):
#   set this to the backend's public URL.
# VITE_API_URL=https://api.yourdomain.com

# Reown AppKit (WalletConnect) project ID. Required for wallet connect on the
# Register page and the wallet button in the app top bar.
# Create a free project at https://cloud.reown.com and paste its Project ID here.
VITE_REOWN_PROJECT_ID=your_reown_project_id

# MultiSender contract that batches the pack-purchase payout to the buyer's
# upline + platform fee in one BEP-20 transaction.
VITE_MULTISENDER_ADDRESS=0xbe417c4936453fAC6D6c8d36b0d161a1AA4Ff624

# Mock USDT token address (used for testing). The purchase API may also return
# it (token_contract); this env value is the fallback.
VITE_USDT_ADDRESS=
# Token decimals for the mock USDT (default 18).
VITE_USDT_DECIMALS=18
